    "permissions.thirdSection.message" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The third section stores shortcuts for files you drag into EchoDock. Accessibility access is only required for global Command-Z Trash undo; the third section itself works without it."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "第三栏会保存你拖入 EchoDock 的文件快捷方式。只有使用全局 Command-Z 撤销废纸篓操作时才需要辅助功能权限，不授权也不影响第三栏本身。"
          }
        }
      }
    },
